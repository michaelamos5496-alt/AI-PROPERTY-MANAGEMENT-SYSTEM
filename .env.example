# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables.

NODE_ENV=development
PORT=3000
# Public origin of this app (https in production). Used for email links and CSRF origin checks.
APP_URL=http://localhost:3000

# Supabase project: Project Settings -> API
SUPABASE_URL=http://127.0.0.1:54321
# The anon (public) key. Used by the server only; it is never sent to browsers.
SUPABASE_ANON_KEY=

LOG_LEVEL=info
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_FINANCE_MAX=60
SESSION_DAYS=14

# --- Background jobs and email (Phase 4) ---------------------------------------------------------
# Service-role key: SERVER ONLY. Used by the scheduled-jobs endpoint and email worker. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/internal/jobs/run (>= 32 chars). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# 'log' (development: nothing is sent) or 'resend'
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="Property AI <notifications@yourdomain.com>"
EMAIL_BATCH_SIZE=20
# Flush the email queue right after writes that notify people (critical escalations go out immediately).
EMAIL_INLINE_DELIVERY=true
RATE_LIMIT_INTERNAL_MAX=12

# --- AI copilot (Phase 5) ---------------------------------------------------------------------------
# 'offline' = built-in rules engine, no key and no network (default). 'anthropic' = Claude via the Anthropic API.
LLM_PROVIDER=offline
# SERVER ONLY. Never expose it to a browser; it is not logged and the bundle scan fails the build if it leaks.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=2000
# Your prices, in millionths of a US dollar per million tokens (3000000 = $3.00 per Mtok). Used for the daily budget.
LLM_INPUT_MICRO_PER_MTOK=3000000
LLM_OUTPUT_MICRO_PER_MTOK=15000000
COPILOT_MAX_TOOL_ITERATIONS=6
COPILOT_MAX_TOOL_CALLS=12
COPILOT_MAX_RESULT_BYTES=20000
COPILOT_TURN_DEADLINE_MS=50000
COPILOT_MAX_CONCURRENT=8
# First of two switches for AI-prepared emails to tenants (an admin must also enable it per organization). Off by default.
COPILOT_EXTERNAL_ENABLED=false

# --- WhatsApp tenant assistant (Phase 6) ------------------------------------------------------------
# 'log' = record outbound messages, send nothing (default). 'cloud' = Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER=log
# Meta app secret (App settings -> Basic). Used ONLY to verify webhook signatures. Server only.
WHATSAPP_APP_SECRET=
# Any random string >= 16 chars; paste the same value into the webhook "Verify token" field in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# System-user access token with whatsapp_business_messaging. Server only.
WHATSAPP_ACCESS_TOKEN=
# Confirm against Meta's current docs; this is configuration, not a pin.
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_INBOUND_MAX_PER_10MIN=20
WHATSAPP_INLINE_BUDGET_MS=3000

# --- Billing (Phase 7) -------------------------------------------------------------------------------
# 'none' = billing integration PENDING: plans/limits are fully enforced, plans are assigned by an operator
# (POST /api/internal/billing/assign with the CRON_SECRET). 'paystack' = Paystack subscriptions.
BILLING_PROVIDER=none
# Server only. This is also the key Paystack signs webhooks with.
PAYSTACK_SECRET_KEY=
# Currencies your Paystack account can ACTUALLY charge (comma separated). Confirm with Paystack; do not assume NGN, GHS and KES all work.
BILLING_PAYSTACK_CURRENCIES=NGN
