{
  "name": "property-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch --env-file-if-exists=.env src/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run typecheck && npm run build:web && node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:api": "vitest run tests/api",
    "test:security": "vitest run tests/security",
    "load": "tsx tests/load/run.ts standard --report docs/LOAD_TEST_RESULTS.md",
    "demo": "npm run build:web && tsx scripts/demo.ts",
    "load:smoke": "tsx tests/load/run.ts smoke",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "pg": "^8.23.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.4"
  }
}
